filters:
  and:
    - or:
        - type == "task"
        - type == "story"
        - type == "epic"
formulas:
  priority_score: if(ice_e, ((ice_i * ice_c) / ice_e).round(2), 0)
  urgency_bonus: if(deadline, if((date(deadline) - today()).days < 0, 5, if((date(deadline) - today()).days == 0, 30, if((date(deadline) - today()).days == 1, 15, 0))), 0)
  today_score: if(ice_e, ((ice_i * ice_c) / ice_e).round(2), 0) + if(deadline, if((date(deadline) - today()).days < 0, 5, if((date(deadline) - today()).days == 0, 30, if((date(deadline) - today()).days == 1, 15, 0))), 0)
  task_title: file.asLink(if(title, title, file.basename))
properties:
  formula.task_title:
    displayName: Story
  formula.priority_score:
    displayName: Score
  formula.today_score:
    displayName: Score
  type:
    displayName: Typ
  parent:
    displayName: Epic
  project:
    displayName: Project
  status:
    displayName: Status
  focus:
    displayName: Fokus
  agent:
    displayName: Agent
  deadline:
    displayName: Deadline
  waitUntil:
    displayName: Wait until
views:
  - type: table
    name: ProjectEpics
    filters:
      and:
        - project == this.file.asLink()
        - type == "epic"
        - status != "Done"
        - status != "Cancelled"
    order:
      - id
      - formula.task_title
      - status
      - file.mtime
    sort:
      - property: id
        direction: ASC
    columnSize:
      formula.task_title: 620
  - type: kanban
    name: ProjectStoriesKanban
    filters:
      and:
        - project == this.file.asLink()
        - type == "story"
        - status != "Done"
        - status != "Cancelled"
    groupBy:
      property: status
      direction: ASC
    order:
      - formula.priority_score
      - deadline
      - parent
    kanbanState:
      columnOrders:
        note.status:
          - Doing
          - Next
          - Waiting
          - Backlog
  - type: table
    name: ProjectStoriesByParent
    filters:
      and:
        - project == this.file.asLink()
        - type == "story"
        - status != "Done"
        - status != "Cancelled"
    groupBy:
      property: parent
      direction: ASC
    order:
      - id
      - formula.task_title
      - status
      - formula.priority_score
      - focus
      - agent
      - deadline
    sort:
      - property: formula.priority_score
        direction: DESC
    summaries:
      formula.task_title: Count
    columnSize:
      formula.task_title: 520
  - type: table
    name: ProjectStandaloneStories
    filters:
      and:
        - project == this.file.asLink()
        - type == "story"
        - status != "Done"
        - status != "Cancelled"
        - "!parent"
    order:
      - id
      - formula.task_title
      - status
      - formula.priority_score
      - focus
      - agent
    sort:
      - property: formula.priority_score
        direction: DESC
    columnSize:
      formula.task_title: 560
  - type: table
    name: ProjectStoriesFocus
    filters:
      and:
        - project == this.file.asLink()
        - type == "story"
        - status != "Done"
        - status != "Cancelled"
        - status != "Waiting"
        - status != "Backlog"
        - focus
    order:
      - id
      - formula.task_title
      - focus
      - agent
      - formula.today_score
      - deadline
    sort:
      - property: focus
        direction: DESC
      - property: formula.today_score
        direction: DESC
    limit: 5
  - type: table
    name: ProjectRecentDone
    filters:
      and:
        - project == this.file.asLink()
        - or:
            - type == "story"
            - type == "task"
        - status == "Done"
    order:
      - id
      - formula.task_title
      - type
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 8
