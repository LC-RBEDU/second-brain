filters:
  and:
    - or:
        - type == "task"
        - type == "story"
        - type == "epic"
formulas:
  priority_score: if(ice_e, ((ice_i * ice_c) / ice_e).round(2), 0)
  due: if(deadline, if(review_deadline, if(date(deadline) < date(review_deadline), date(deadline), date(review_deadline)), date(deadline)), if(review_deadline, date(review_deadline), null))
  urgency_bonus: if(deadline, if((date(deadline) - today()).days < 0, 5, if((date(deadline) - today()).days == 0, 30, if((date(deadline) - today()).days == 1, 15, 0))), 0)
  today_score: if(ice_e, ((ice_i * ice_c) / ice_e).round(2), 0) + if(if(deadline, if((date(deadline) - today()).days < 0, 5, if((date(deadline) - today()).days == 0, 30, if((date(deadline) - today()).days == 1, 15, 0))), 0) > if(review_deadline, if((date(review_deadline) - today()).days < 0, 5, if((date(review_deadline) - today()).days == 0, 20, if((date(review_deadline) - today()).days == 1, 10, 0))), 0), if(deadline, if((date(deadline) - today()).days < 0, 5, if((date(deadline) - today()).days == 0, 30, if((date(deadline) - today()).days == 1, 15, 0))), 0), if(review_deadline, if((date(review_deadline) - today()).days < 0, 5, if((date(review_deadline) - today()).days == 0, 20, if((date(review_deadline) - today()).days == 1, 10, 0))), 0))
  task_title: file.asLink(if(title, title, file.basename))
properties:
  formula.task_title:
    displayName: Story
  formula.priority_score:
    displayName: Score
  formula.today_score:
    displayName: Score
  formula.due:
    displayName: Due
  type:
    displayName: Typ
  parent:
    displayName: Epic
  project:
    displayName: Project
  status:
    displayName: Status
  focus:
    displayName: Fokus
  agent:
    displayName: Agent
  deadline:
    displayName: Deadline
  review_deadline:
    displayName: Review
  waitUntil:
    displayName: Wait until
views:
  - type: table
    name: ProjectEpics
    filters:
      and:
        - project == this.file.asLink()
        - type == "epic"
        - status != "Done"
        - status != "Cancelled"
    order:
      - id
      - formula.task_title
      - status
      - file.mtime
    sort:
      - property: id
        direction: ASC
    columnSize:
      formula.task_title: 620
  - type: table
    name: EpicStories
    filters:
      and:
        - parent == this.file.asLink()
        - status != "Done"
        - status != "Cancelled"
    order:
      - id
      - formula.task_title
      - status
      - formula.priority_score
      - focus
      - agent
      - deadline
    sort:
      - property: formula.priority_score
        direction: DESC
    summaries:
      formula.task_title: Count
    columnSize:
      formula.task_title: 520
  - type: table
    name: EpicStoriesDone
    filters:
      and:
        - parent == this.file.asLink()
        - or:
            - status == "Done"
            - status == "Cancelled"
    order:
      - id
      - formula.task_title
      - status
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    summaries:
      formula.task_title: Count
    columnSize:
      formula.task_title: 520
  - type: kanban
    name: ProjectStoriesKanban
    filters:
      and:
        - project == this.file.asLink()
        - type == "story"
        - status != "Done"
        - status != "Cancelled"
    groupBy:
      property: status
      direction: ASC
    order:
      - formula.priority_score
      - deadline
      - parent
    kanbanState:
      columnOrders:
        note.status:
          - Doing
          - Next
          - Waiting
          - Backlog
      cardOrders:
        note.status:
          Backlog:
            - 02-PROJEKTY/finance/tasks/F-S22 — Prověřit Národní záruku (NRBCZ) pro firmu.md
            - 02-PROJEKTY/finance/tasks/F-S55 — Workflow pro Revolut Business platební karty.md
            - 02-PROJEKTY/finance/tasks/F-S9 — Procesní mapa a mapa zodpovědností finančního týmu.md
          Next:
            - 02-PROJEKTY/finance/tasks/F-S16 — Overdue faktury zkontrolovat spárování + spustit remindery.md
            - 02-PROJEKTY/finance/tasks/F-S19 — Šuplíčky Happiness srovnání + mock doklady + procesní dokument.md
            - 02-PROJEKTY/finance/tasks/F-S26 — Firemní karty a Revolut — vystavování, distribuce parťákům, doplňování.md
            - 02-PROJEKTY/finance/tasks/F-S33 — Ověřit u Lenky výsledek daňové konzultace (ubytování externistů, karty, interní eventy).md
            - 02-PROJEKTY/finance/tasks/F39 — Finanční přehled MOCK doklady — pohledy Honza + Luboš.md
            - 02-PROJEKTY/finance/tasks/F-S41 — FIO kontokorent — SSOT podmínek čerpání.md
            - 02-PROJEKTY/finance/tasks/F-S43 — Pravidla pro platby.md
            - 02-PROJEKTY/finance/tasks/F-S46 — Nákladové rozpočty RBL — doplnit plán výdajů v čase.md
            - 02-PROJEKTY/finance/tasks/F-S50 — Třídění účetních PDF do složek podle středisek.md
            - 02-PROJEKTY/finance/tasks/F-S51 — Pojištění majetku v kanceláři Impact Hub.md
            - 02-PROJEKTY/finance/tasks/F-S52 — IBAN nesoulad faktura vs. dodavatel — Slack alert v platební automatizaci.md
            - 02-PROJEKTY/finance/tasks/F-S54 — Fix manuální příprava FIO příkazů + první čtvrtek.md
            - 02-PROJEKTY/finance/tasks/F-S61 — Kurzová politika faktur ECB vs. ČNB (interní směrnice).md
          Waiting:
            - 02-PROJEKTY/finance/tasks/F-S53 — Sledovat — Lenka Turečková dodá podklad Google Vault.md
  - type: table
    name: ProjectStoriesByParent
    filters:
      and:
        - project == this.file.asLink()
        - type == "story"
        - status != "Done"
        - status != "Cancelled"
    groupBy:
      property: parent
      direction: ASC
    order:
      - id
      - formula.task_title
      - status
      - formula.priority_score
      - focus
      - agent
      - deadline
    sort:
      - property: formula.priority_score
        direction: DESC
    summaries:
      formula.task_title: Count
    columnSize:
      formula.task_title: 520
  - type: table
    name: ProjectStandaloneStories
    filters:
      and:
        - project == this.file.asLink()
        - type == "story"
        - status != "Done"
        - status != "Cancelled"
        - "!parent"
    order:
      - id
      - formula.task_title
      - status
      - formula.priority_score
      - focus
      - agent
    sort:
      - property: formula.priority_score
        direction: DESC
    columnSize:
      formula.task_title: 560
  - type: table
    name: ProjectStoriesFocus
    filters:
      and:
        - project == this.file.asLink()
        - type == "story"
        - status != "Done"
        - status != "Cancelled"
        - status != "Waiting"
        - status != "Backlog"
        - focus
    order:
      - id
      - formula.task_title
      - focus
      - agent
      - formula.today_score
      - deadline
    sort:
      - property: focus
        direction: DESC
      - property: formula.today_score
        direction: DESC
    limit: 5
  - type: table
    name: ProjectRecentDone
    filters:
      and:
        - project == this.file.asLink()
        - or:
            - type == "story"
            - type == "task"
        - status == "Done"
    order:
      - id
      - formula.task_title
      - type
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 8
  - type: table
    name: FokusTydne
    filters:
      and:
        - or:
            - type == "story"
            - type == "task"
        - status != "Done"
        - status != "Cancelled"
        - status != "Waiting"
        - status != "Backlog"
        - focus
    order:
      - id
      - formula.task_title
      - type
      - project
      - focus
      - agent
      - formula.today_score
      - deadline
    sort:
      - property: focus
        direction: DESC
      - property: formula.today_score
        direction: DESC
    limit: 5
    columnSize:
      formula.task_title: 516
  - type: table
    name: KandidatiNaFokus
    filters:
      and:
        - or:
            - type == "story"
            - type == "task"
        - status != "Done"
        - status != "Cancelled"
        - status != "Waiting"
        - status != "Backlog"
        - "!focus"
    order:
      - id
      - formula.task_title
      - type
      - project
      - agent
      - formula.today_score
      - deadline
    sort:
      - property: formula.task_title
        direction: ASC
      - property: formula.today_score
        direction: DESC
    limit: 10
    columnSize:
      formula.task_title: 516
