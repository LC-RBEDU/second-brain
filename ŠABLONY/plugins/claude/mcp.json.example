{
  "mcpServers": {
    "second-brain-brain": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://brain.cyprovi.cz/mcp/",
        "--header",
        "Authorization:${BRAIN_AUTHORIZATION}"
      ],
      "env": {
        "BRAIN_AUTHORIZATION": "Bearer <BRAIN_SERVICE_TOKEN from Coolify second-brain-brain>"
      }
    }
  }
}
