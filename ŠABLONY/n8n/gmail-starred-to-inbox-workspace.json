    {
      "parameters": {
        "jsCode": "\nconst TZ = 'Europe/Prague';\nconst MAILBOX = 'workspace';\nfunction yamlQuote(s) {\n  return JSON.stringify(String(s || '').replace(/\\n/g, ' '));\n}\nfunction headerOf(msg, name) {\n  const want = String(name).toLowerCase();\n  const headers = (msg && msg.payload && msg.payload.headers) || msg.headers || [];\n  if (Array.isArray(headers)) {\n    const row = headers.find((h) => String(h.name || '').toLowerCase() === want);\n    return row ? String(row.value || '') : '';\n  }\n  if (headers && typeof headers === 'object') {\n    for (const [k, v] of Object.entries(headers)) {\n      if (String(k).toLowerCase() === want) return String(v || '');\n    }\n  }\n  return String(msg[name] || '');\n}\nfunction decodeBody(msg) {\n  const payload = msg.payload || msg;\n  const chunks = [];\n  function walk(p) {\n    if (!p) return;\n    if (p.body && p.body.data) {\n      try {\n        const b64 = String(p.body.data).replace(/-/g, '+').replace(/_/g, '/');\n        chunks.push(Buffer.from(b64, 'base64').toString('utf8'));\n      } catch (e) {}\n    }\n    if (Array.isArray(p.parts)) p.parts.forEach(walk);\n  }\n  walk(payload);\n  let text = chunks.join('\\n').trim();\n  if (!text) text = String(msg.snippet || msg.text || '').trim();\n  if (/<html|<div|<br/i.test(text)) {\n    text = text.replace(/<br\\s*\\/?>/gi, '\\n').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').trim();\n  }\n  return text || '_(pr\u00e1zdn\u00e9 t\u011blo)_';\n}\nconst out = [];\nconst seen = new Set();\nfor (const item of $input.all()) {\n  const j = item.json;\n  let threadId = String(j.id || j.threadId || '').trim();\n  let messages = j.messages;\n  if (!Array.isArray(messages)) continue;\n  if (!threadId) threadId = String((messages[0] && messages[0].threadId) || '').trim();\n  if (!threadId || seen.has(threadId)) continue;\n  seen.add(threadId);\n  const parts = [];\n  let subject = '';\n  let firstFrom = '';\n  let lastDate = '';\n  for (const m of messages) {\n    const sub = headerOf(m, 'subject') || m.Subject || m.subject || '';\n    const from = headerOf(m, 'from') || m.From || '';\n    const to = headerOf(m, 'to') || m.To || '';\n    const date = headerOf(m, 'date') || m.Date || m.date || '';\n    if (!subject && sub) subject = sub;\n    if (!firstFrom && from) firstFrom = from;\n    if (date) lastDate = date;\n    parts.push(`### ${date || '?'}\\n**From**: ${from}\\n**To**: ${to}\\n\\n${decodeBody(m)}\\n`);\n  }\n  subject = subject || 'no-subject';\n  const filename = `sb-${MAILBOX}-${threadId}.md`;\n  const fm = ['---','source: email',`mailbox: ${MAILBOX}`,`gmail_thread_id: ${yamlQuote(threadId)}`,`from: ${yamlQuote(firstFrom)}`,`subject: ${yamlQuote(subject)}`,`date: ${yamlQuote(lastDate)}`,'---',''].join('\\n');\n  const md = fm + `# Email: ${subject}\\n\\n**Mailbox**: ${MAILBOX}\\n**Thread**: ${threadId}\\n\\n` + parts.join('\\n---\\n\\n');\n  out.push({ json: { filename, content: md, threadId, mailbox: MAILBOX } });\n}\nreturn out;\n"
      },
      "id": "e41b7d03-2a84-46a2-a4f4-6a0364f4643c",
