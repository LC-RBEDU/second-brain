    {
      "parameters": {
        "jsCode": "\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.fileByThread) staticData.fileByThread = {};\nconst out = [];\nfor (const item of $input.all()) {\n  const id = String(item.json.id || '');\n  // threadId from paired Create/Update input\n  let threadId = '';\n  try {\n    threadId = String($('Route create/update').item.json.threadId || '');\n  } catch (e) {\n    threadId = String(item.json.appProperties && item.json.appProperties.threadId || '');\n  }\n  if (!threadId) {\n    // fallback: parse from filename sb-workspace-THREAD.md\n    const name = String(item.json.name || '');\n    const m = name.match(/^sb-(?:workspace|personal)-(.+)\\.md$/);\n    if (m) threadId = m[1];\n  }\n  if (id && threadId) staticData.fileByThread[threadId] = id;\n  out.push({\n    json: {\n      threadId: threadId || $('Route create/update').item.json.threadId,\n      fileId: id,\n    },\n  });\n}\nreturn out;\n"
      },
