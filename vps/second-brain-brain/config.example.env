# Coolify / local Brain — copy secrets out of band; never commit real values.
BRAIN_PUBLIC_URL=https://brain.cyprovi.cz
VAULT_BACKEND=git
GIT_VAULT_ROOT=/data/vault
GIT_VAULT_PUSH=1
GIT_VAULT_REMOTE=git@github.com:LC-RBEDU/second-brain-vault.git
GIT_VAULT_BRANCH=main
GIT_AUTHOR_NAME=Second Brain Brain
GIT_AUTHOR_EMAIL=second-brain-brain@noreply.redbuttonedu.cz
TZ=Europe/Prague
# Google OAuth (F2-c)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Service token for machine clients (F2-c)
# BRAIN_SERVICE_TOKEN=
# Grok Bot reminder routine webhook (hub dispatch F2-i — see docs/brain-api-runbook.md)
# GROK_BOT_REMINDER_WEBHOOK_URL=
# GROK_BOT_REMINDER_WEBHOOK_KEY=
# F3 — Gmail L1 read (Workspace + personal refresh tokens)
# GMAIL_WORKSPACE_REFRESH_TOKEN=
# GMAIL_PERSONAL_REFRESH_TOKEN=
# F3 — meeting prep (Grok Bot dedicated webhook; look-ahead minutes)
# GROK_BOT_MEETING_PREP_WEBHOOK_URL=
# GROK_BOT_MEETING_PREP_WEBHOOK_KEY=
MEETING_PREP_WINDOW_MINUTES=70
# F3 — Universe + Drive for prepare_meeting (degrade if missing)
# UNIVERSE_API_BASE=https://api.universe.redbuttonedu.cz
# UNIVERSE_API_TOKEN=
# GOOGLE_DRIVE_SA_JSON=
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# F3 — Coolify Brain replicas must be 1 (in-memory propose batches)
# SLACK_USER_TOKEN=
# SLACK_LUKAS_USER_ID=
