# Second Brain v2 — Europe/Prague (supercronic)
# Vault: VAULT_BACKEND=git. GIT_VAULT_ROOT=/data/vault + deploy key; dirty-only commit/push.
# Pause schedule: deploy/crontab.pause when CRONTAB_MODE=pause or VAULT_WRITERS_PAUSED=1.
#
# V2 architecture (since F6/F7):
# - File-per-task in 02-PROJEKTY/<slug>/tasks/*.md (not H3 in hub anymore)
# - Bases dashboard reads frontmatter live (no JSON build needed for Obsidian view)
# - Lifecycle scripts: done_from_checkboxes, waiting_to_next, overdue_flag, archive_done, recurring
# - Legacy build_dashboard.py + sync_tasks_from_projekty.py kept only for HTML dashboard backwards-compat
#   (deletion in F9 — keep until F8 agent-context.json is in production)
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin
CALENDAR_DAYS_AHEAD=2
TZ=Europe/Prague

# === V2 LIFECYCLE (every 2 hours, staggered +0–+6 min) ===
# :00 — done from checkboxes (auto-flip status: Done if all [x])
0 */2 * * * /usr/local/bin/python3 /app/cron/lifecycle_done_from_checkboxes.py >> /var/log/second-brain/lifecycle.log 2>&1
# :01 — waiting → Next when waitUntil expired (clears waitUntil)
1 */2 * * * /usr/local/bin/python3 /app/cron/lifecycle_waiting_to_next.py >> /var/log/second-brain/lifecycle.log 2>&1
# :02 — Waiting without waitUntil → default +3 days (reactivation date)
2 */2 * * * /usr/local/bin/python3 /app/cron/lifecycle_waiting_default_waituntil.py >> /var/log/second-brain/lifecycle.log 2>&1
# :03 — clear stray waitUntil on non-Waiting tasks (manual status edits)
3 */2 * * * /usr/local/bin/python3 /app/cron/lifecycle_waituntil_hygiene.py >> /var/log/second-brain/lifecycle.log 2>&1
# :04 — overdue flag (append OVERDUE log line in body)
4 */2 * * * /usr/local/bin/python3 /app/cron/lifecycle_overdue_flag.py >> /var/log/second-brain/lifecycle.log 2>&1
# :05 — archive Done tasks (move .md → 07-ARCHIV/tasks-done/<slug>/)
5 */2 * * * /usr/local/bin/python3 /app/cron/archive_done_tasks.py >> /var/log/second-brain/lifecycle.log 2>&1
# :06 — recurring tasks rotation (Done → archive + create next instance, F7.2)
6 */2 * * * /usr/local/bin/python3 /app/cron/lifecycle_recurring.py >> /var/log/second-brain/lifecycle.log 2>&1
# :07 — hub charter ## Stav (auto) blocks + staleness flags
7 */2 * * * /usr/local/bin/python3 /app/cron/lifecycle_hub_state.py >> /var/log/second-brain/lifecycle.log 2>&1
# :08 — sort ## Operativní kroky (open first, ascending by subtask number)
8 */2 * * * /usr/local/bin/python3 /app/cron/lifecycle_sort_steps.py >> /var/log/second-brain/lifecycle.log 2>&1
# :09 — GitHub Closes RBU* on branch dev → vault checkbox / story Done (needs GITHUB_TOKEN)
9 */2 * * * /usr/local/bin/python3 /app/cron/lifecycle_github_rbu_closes.py >> /var/log/second-brain/lifecycle.log 2>&1

# === TRIAGE ===
# Cron batch / LLM writers removed 2026-09-24 — chat-only (agenda-triage BATCH/DEEP).
# Fallback inventory (Po 6:55 — log only, no proposals)
55 6 * * 1-5 /usr/local/bin/python3 /app/cron/inbox_inventory.py >> /var/log/second-brain/triage.log 2>&1

# === EDU NEWS ===
# Témata připravuje Cursor skill `agenda-edu-news` on-demand (ne cron).
# Volitelný reset markeru po nahrání: python3 cron/lifecycle_extra_edu_news.py --reset
# (denní 7:10 job zrušen 2026-08-06)

# === WEEKLY (Sunday evening) — retro_draft zrušen 2026-08-08 (→ agenda-lessons) ===
0 20 * * 0 /usr/local/bin/python3 /app/cron/weekly_summary_draft.py >> /var/log/second-brain/weekly.log 2>&1

# === AGENT CONTEXT (F8) ===
# Every 15 min during workday — refresh agent-context.json
*/15 7-22 * * * /usr/local/bin/python3 /app/cron/build_agent_context.py >> /var/log/second-brain/agent-context.log 2>&1
# :05 stagger — sources-routing.json drift guard (from Zdroje-katalog.md SSOT)
5 7-22 * * * /usr/local/bin/python3 /app/cron/build_sources_routing.py >> /var/log/second-brain/agent-context.log 2>&1

# === REMINDERS (Slack DM — agent-scheduled) ===
# Every 2 min — dispatch due items from 00-System/Reminders-Pending/
*/2 * * * * /usr/local/bin/python3 /app/cron/reminders_dispatch.py >> /var/log/second-brain/reminders.log 2>&1

# === SLACK WATCHLIST — F4: dump off; live = Brain slack_live / get_triage_candidates ===
# Cron řádek zakomentován. Kill-switch: SLACK_POLL_DUMP=0 (no-op pokud by se skript spustil).
# Kód cron/slack_poll.py zůstává ≤14 dní pro rollback.
# */2 8-23 * * * /usr/local/bin/python3 /app/cron/slack_poll.py >> /var/log/second-brain/slack-poll.log 2>&1

# === F3 PROACTIVITY + MEETING PREP (Europe/Prague) ===
# Morning / evening triage nudge (no propose/apply). due = hourly WD 9–17.
0 8 * * 1-5 /usr/local/bin/python3 /app/cron/proactivity_dispatch.py --trigger morning >> /var/log/second-brain/proactivity.log 2>&1
0 9-17 * * 1-5 /usr/local/bin/python3 /app/cron/proactivity_dispatch.py --trigger due >> /var/log/second-brain/proactivity.log 2>&1
0 18 * * 1-5 /usr/local/bin/python3 /app/cron/proactivity_dispatch.py --trigger evening >> /var/log/second-brain/proactivity.log 2>&1
# Meeting prep look-ahead 70 min (MEETING_PREP_WINDOW_MINUTES); cadence */15 8–23 (A37)
*/15 8-23 * * * /usr/local/bin/python3 /app/cron/meeting_prep_dispatch.py >> /var/log/second-brain/meeting-prep.log 2>&1
# Meeting-Preps GC >14d
30 3 * * * /usr/local/bin/python3 /app/cron/meeting_preps_gc.py >> /var/log/second-brain/meeting-prep.log 2>&1

# === FOCUS (priority model v2) ===
# No cron writes `focus` — it is the one field only the human sets.
# When fewer than 5 tasks carry the current ISO week, build_agent_context.py fills
# `focus_suggestions[]` with ranked candidates. Suggestions, never promotions.

