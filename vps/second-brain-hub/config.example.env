# second-brain-hub — config.example.env
# Copy to config.env locally or paste into Coolify → Environment Variables.

# === Vault backend (F1) ===
# drive = Google Drive API (default — no behavior change until cutover)
# git   = local WC at GIT_VAULT_ROOT + push via deploy key
VAULT_BACKEND=drive

# Cron schedule mode (A33): live = full /app/crontab (default); pause = heartbeat only.
# Independent of VAULT_WRITERS_PAUSED. F1-e/f/g → pause; F1-h → live.
CRONTAB_MODE=live

# Kill-switch: block all vault mutates (write/mkdir/move/delete). F1-e→f = 1.
VAULT_WRITERS_PAUSED=0

# === Google Drive (when VAULT_BACKEND=drive) ===
VAULT_DRIVE_ID=1YTTsTWFzrH6cNcZfvO_R-rhmSyFvlfz-
# OAuth user credentials (refresh token) for Drive API.
# Generate with: python3 scripts/oauth_setup.py
GOOGLE_DRIVE_OAUTH_JSON={"installed":{"client_id":"...","client_secret":"...","refresh_token":"..."}}

# === Git vault (when VAULT_BACKEND=git) ===
GIT_VAULT_ROOT=/data/vault
GIT_VAULT_REMOTE=git@github.com:LC-RBEDU/second-brain-vault.git
GIT_VAULT_BRANCH=main
# F1-g smoke: DRY_RUN=1 (no WT write). F1-h: DRY_RUN=0 + PUSH=1.
GIT_VAULT_DRY_RUN=0
GIT_VAULT_PUSH=0
GIT_AUTHOR_NAME=Second Brain Hub
GIT_AUTHOR_EMAIL=second-brain-hub@noreply.redbuttonedu.cz

# === Google Calendar (read-only) ===
GOOGLE_DRIVE_SA_JSON={"type":"service_account","project_id":"..."}
CALENDAR_USER_EMAIL=lukas@redbuttonedu.cz
CALENDAR_DAYS_AHEAD=2

# === Misc ===
TZ=Europe/Prague

# === Slack ===
SLACK_USER_TOKEN=xoxp-...
# SLACK_LUKAS_USER_ID=U014AEZD72S
SLACK_BOT_TOKEN=xoxb-...
# SLACK_REMINDER_USER_EMAIL=lukas@redbuttonedu.cz

# === GitHub → RBU auto-Done ===
GITHUB_TOKEN=ghp_...
# RBU_GITHUB_REPO=RedButtonEDU/RB-Universe
# RBU_GITHUB_BRANCH=dev

# === Mac local (not Coolify) ===
# SECOND_BRAIN_VAULT=~/GitHub/second-brain-vault
# SECOND_BRAIN_VAULT_READONLY=1
