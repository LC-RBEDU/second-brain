# second-brain-hub — config.example.env
# Copy to config.env locally or paste into Coolify → Environment Variables.

# === Google Drive (vault I/O) ===
# OBSIDIAN folder ID in user's Drive (Drive root for vault).
VAULT_DRIVE_ID=1YTTsTWFzrH6cNcZfvO_R-rhmSyFvlfz-

# OAuth user credentials (refresh token) for Drive API.
# Generate with: python3 scripts/oauth_setup.py
# Paste single-line JSON: cat ~/.config/mrluc/oauth_creds.json | jq -c .
GOOGLE_DRIVE_OAUTH_JSON={"installed":{"client_id":"...","client_secret":"...","refresh_token":"..."}}

# === Google Calendar (read-only events for dashboard) ===
# Service Account with Domain-Wide Delegation, subject = lukas@redbuttonedu.cz.
GOOGLE_DRIVE_SA_JSON={"type":"service_account","project_id":"..."}
CALENDAR_USER_EMAIL=lukas@redbuttonedu.cz
CALENDAR_DAYS_AHEAD=2

# === Misc ===
TZ=Europe/Prague

# === Slack user token (slack_poll.py — mentions, Later, DM). Not the bot token. ===
# xoxp- from ~/.config/second-brain/slack.env. Coolify env only, never git.
SLACK_USER_TOKEN=xoxp-...
# SLACK_LUKAS_USER_ID=U014AEZD72S

# === Gmail drafts (assistant_ingest.py). Separate consent from Drive. ===
# python3 scripts/gmail_oauth_setup.py → paste JSON. Scope gmail.compose.
# Hub code calls drafts.create only, never drafts.send / messages.send.
GOOGLE_GMAIL_OAUTH_JSON={"client_id":"...","client_secret":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token","scopes":["https://www.googleapis.com/auth/gmail.compose"]}

# === Slack reminders (reminders_dispatch.py) ===
# Bot token = stejný xoxb-... jako n8n credential „Slack - Lukáš - RB EDU“ (Cowork Capture).
# Token v n8n ≠ automaticky v tomto kontejneru — zkopíruj do Coolify jako SLACK_BOT_TOKEN.
SLACK_BOT_TOKEN=xoxb-...
# Email pro DM lookup — fallback na CALENDAR_USER_EMAIL (už v Coolify)
# SLACK_REMINDER_USER_EMAIL=lukas@redbuttonedu.cz

# === GitHub → RBU auto-Done (lifecycle_github_rbu_closes.py) ===
# Fine-grained or classic token with read access to RedButtonEDU/RB-Universe.
GITHUB_TOKEN=ghp_...
# RBU_GITHUB_REPO=RedButtonEDU/RB-Universe
# RBU_GITHUB_BRANCH=dev
# RBU_GITHUB_INCLUDE_PRS=1

# === Local-only override (NOT used in Coolify) ===
# When running cron scripts on Mac without Drive API, point lib/drive_io.py at the
# local Drive Desktop mirror via VAULT_PATH. Cron container ignores this.
# VAULT_PATH=/Users/lukascypra/My Drive (lukas@redbuttonedu.cz)/SECOND_BRAIN/OBSIDIAN
